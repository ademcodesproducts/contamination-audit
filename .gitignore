# ===== Bulk data and results (regenerable) =====
# Raw datasets — downloaded from HuggingFace by scripts/00_load_datasets.py
data/raw/*.jsonl

# Embedding caches — regenerated by scripts/02_embedding_retrieval.py
results/embeddings/*.npy

# Bulk pipeline outputs (kept locally; not tracked)
results/ngram/
results/embeddings/
results/judge/
results/traces/

# Tables and figures (small, tracked) are NOT ignored — they live in results/tables/ and results/figures/

# Markdown files
REFACTOR_NOTES.md

# Paper artifact: the benchmark groups are small and are the paper's own
# contribution, so they are tracked. The Dolci corpus is not -- it is ~300MB and
# regenerates from HuggingFace via scripts/19_prepare_paper_data.py.
!data/raw/bench_measure.jsonl
!data/raw/bench_control.jsonl
!data/raw/olymmath_en_hard.jsonl
!data/raw/olymmath_en_easy.jsonl

# decon's working copies of the corpus and evals (78MB, regenerated by
# scripts/21_run_decon.py). The summary it produces, results/paper/decon.json,
# is tracked.
results/paper/decon_run/
